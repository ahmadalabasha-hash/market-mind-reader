// ── Excel helpers ─────────────────────────────────────────────────────────────
function xmlEsc(v){return v==null?"":String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function xh(v){return {v:v,s:"hdr"};}
function xsb(v){return {v:v,s:"sub"};}
function xn(v){return {v:v==null?0:parseFloat(v)||0,s:"num"};}
function xc(v,style){return {v:v==null?"":v,s:style||"std"};}
function xw(v){return {v:v,s:"warn"};}
function xok(v){return {v:v,s:"ok"};}

function buildXls(sheets){
  var xml='<?xml version="1.0" encoding="UTF-8"?><?mso-application progid="Excel.Sheet"?>';
  xml+='<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:x="urn:schemas-microsoft-com:office:excel">';
  xml+='<Styles>';
  xml+='<Style ss:ID="Default" ss:Name="Normal"><Font ss:FontName="Calibri" ss:Size="11"/></Style>';
  xml+='<Style ss:ID="std"><Font ss:FontName="Calibri" ss:Size="11"/></Style>';
  xml+='<Style ss:ID="hdr"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#1E3A5F" ss:Pattern="Solid"/></Style>';
  xml+='<Style ss:ID="sub"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#D6E4F0" ss:Pattern="Solid"/></Style>';
  xml+='<Style ss:ID="warn"><Font ss:FontName="Calibri" ss:Size="11" ss:Color="#C0392B"/><Interior ss:Color="#FDECEA" ss:Pattern="Solid"/></Style>';
  xml+='<Style ss:ID="ok"><Font ss:FontName="Calibri" ss:Size="11" ss:Color="#1A7A4A"/><Interior ss:Color="#E8F8F0" ss:Pattern="Solid"/></Style>';
  xml+='<Style ss:ID="num"><Font ss:FontName="Calibri" ss:Size="11"/><NumberFormat ss:Format="0.00"/></Style>';
  xml+='<Style ss:ID="blue"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#2471A3"/></Style>';
  xml+='</Styles>';
  sheets.forEach(function(sheet){
    xml+='<Worksheet ss:Name="'+xmlEsc(sheet.name.slice(0,31))+'"><Table>';
    (sheet.cols||[]).forEach(function(cw){xml+='<Column ss:Width="'+cw+'"/>';});
    (sheet.rows||[]).forEach(function(row){
      xml+='<Row>';
      (row||[]).forEach(function(cell){
        var v=cell.v==null?"":cell.v;
        var dtype=typeof v==="number"?"Number":"String";
        xml+='<Cell ss:StyleID="'+(cell.s||"std")+'"><Data ss:Type="'+dtype+'">'+xmlEsc(String(v))+'</Data></Cell>';
      });
      xml+='</Row>';
    });
    xml+='</Table></Worksheet>';
  });
  xml+='</Workbook>';
  return new Blob([xml],{type:"application/vnd.ms-excel;charset=utf-8"});
}

function dlBlob(blob,filename){
  var url=URL.createObjectURL(blob);
  var a=document.createElement("a");
  a.href=url;a.download=filename;
  document.body.appendChild(a);a.click();
  setTimeout(function(){document.body.removeChild(a);URL.revokeObjectURL(url);},500);
}

function exportProductionPlan(state,getBatches,getDrumJobs,from,to){
  var dates=[];var d=from;while(d<=to){dates.push(d);d=addDays(d,1);}
  var wdates=dates.filter(isWorkDay);

  // Sheet 1 - Daily Schedule
  var r1=[[xh("Production Plan — "+from+" to "+to),xh(""),xh(""),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r1.push([xh("Date"),xh("Day"),xh("Reactor"),xh("Product"),xh("Volume KL"),xh("Mix Time h"),xh("Start Time"),xh("Packaging")]);
  wdates.forEach(function(dd){
    var bs=getBatches(dd);
    if(bs.length===0){r1.push([xc(dd),xc(new Date(dd).toLocaleDateString("en-MY",{weekday:"long"})),xc(""),xc("No production"),xc(""),xc(""),xc(""),xc("")]);}
    else bs.forEach(function(b,i){r1.push([xc(i===0?dd:""),xc(i===0?new Date(dd).toLocaleDateString("en-MY",{weekday:"long"}):""),xc(b.reactor),xc(b.product),xn(b.vol),xn(b.mixTime),xc(b.startTime),xc(b.pkg)]);});
  });

  // Sheet 2 - R1
  var r2=[[xh("Reactor R1 — 5 KL Capacity"),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r2.push([xh("Date"),xh("Product"),xh("Volume KL"),xh("Utilised %"),xh("Mix Time h"),xh("Start Time")]);
  wdates.forEach(function(dd){
    var bs=getBatches(dd).filter(function(b){return b.reactor==="R1";});
    if(bs.length===0){r2.push([xc(dd),xc("Idle"),xn(0),xn(0),xc(""),xc("")]);}
    else bs.forEach(function(b,i){r2.push([xc(i===0?dd:""),xc(b.product),xn(b.vol),xn(Math.round((b.vol/5)*100)),xn(b.mixTime),xc(b.startTime)]);});
  });

  // Sheet 3 - R2
  var r3=[[xh("Reactor R2 — 10 KL Capacity"),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r3.push([xh("Date"),xh("Product"),xh("Volume KL"),xh("Utilised %"),xh("Mix Time h"),xh("Start Time")]);
  wdates.forEach(function(dd){
    var bs=getBatches(dd).filter(function(b){return b.reactor==="R2";});
    if(bs.length===0){r3.push([xc(dd),xc("Idle"),xn(0),xn(0),xc(""),xc("")]);}
    else bs.forEach(function(b,i){r3.push([xc(i===0?dd:""),xc(b.product),xn(b.vol),xn(Math.round((b.vol/10)*100)),xn(b.mixTime),xc(b.startTime)]);});
  });

  // Sheet 4 - Summary by Product
  var byProd={};
  wdates.forEach(function(dd){getBatches(dd).forEach(function(b){if(!byProd[b.product])byProd[b.product]={r1v:0,r1n:0,r2v:0,r2n:0,pkg:b.pkg};if(b.reactor==="R1"){byProd[b.product].r1v+=b.vol;byProd[b.product].r1n++;}else{byProd[b.product].r2v+=b.vol;byProd[b.product].r2n++;}});});
  var r4=[[xh("Production Summary by Product"),xh(""),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r4.push([xh("Product"),xh("Packaging"),xh("R1 Batches"),xh("R1 Vol KL"),xh("R2 Batches"),xh("R2 Vol KL"),xh("Total Vol KL")]);
  var grand=0;
  Object.keys(byProd).sort().forEach(function(p){var x=byProd[p];var tot=x.r1v+x.r2v;grand+=tot;r4.push([xc(p),xc(x.pkg),xn(x.r1n),xn(x.r1v),xn(x.r2n),xn(x.r2v),xn(tot)]);});
  r4.push([xsb("TOTAL"),xsb(""),xsb(""),xsb(""),xsb(""),xsb(""),xsb(grand.toFixed(2))]);

  // Sheet 5 - Drumming
  var r5=[[xh("Drumming Schedule"),xh(""),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r5.push([xh("Date"),xh("Product"),xh("Start"),xh("End"),xh("Dur min"),xh("Containers"),xh("Type")]);
  wdates.forEach(function(dd){
    var dj=getDrumJobs(dd);
    if(dj.length===0){r5.push([xc(dd),xc("No drumming"),xc(""),xc(""),xc(""),xc(""),xc("")]);}
    else dj.forEach(function(j,i){r5.push([xc(i===0?dd:""),xc(j.product),xc(j.startTime),xc(calcEnd(j.startTime,j.durMin)),xn(j.durMin),xn(j.drums),xc(j.containerType)]);});
  });

  dlBlob(buildXls([
    {name:"Daily Schedule",cols:[110,130,70,160,80,80,80,120],rows:r1},
    {name:"Reactor R1",cols:[110,160,80,90,80,80],rows:r2},
    {name:"Reactor R2",cols:[110,160,80,90,80,80],rows:r3},
    {name:"Summary by Product",cols:[160,120,90,80,90,80,100],rows:r4},
    {name:"Drumming Schedule",cols:[110,160,70,70,80,90,110],rows:r5}
  ]),"Production_Plan_"+from+"_"+to+".xls");
}

function exportMRP(state,getBatches,from,to){
  var dates=[];var d=from;while(d<=to){dates.push(d);d=addDays(d,1);}
  var wdates=dates.filter(isWorkDay);
  var rawMats=state.rawMaterials||[];
  var gross={};
  wdates.forEach(function(dd){
    getBatches(dd).forEach(function(b){
      var prod=state.products.find(function(p){return p.name===b.product;});
      if(!prod||!prod.bom||prod.bom.length===0)return;
      prod.bom.forEach(function(line){
        var need=line.qtyPerKL*b.vol;
        if(!gross[line.rawId])gross[line.rawId]={rawName:line.rawName,unit:line.unit,total:0,byDate:{},byProd:{}};
        gross[line.rawId].total+=need;
        if(!gross[line.rawId].byDate[dd])gross[line.rawId].byDate[dd]=0;
        gross[line.rawId].byDate[dd]+=need;
        if(!gross[line.rawId].byProd[b.product])gross[line.rawId].byProd[b.product]=0;
        gross[line.rawId].byProd[b.product]+=need;
      });
    });
  });

  // Sheet 1 - MRP Summary
  var r1=[[xh("MRP Report — "+from+" to "+to),xh(""),xh(""),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r1.push([xh("Material"),xh("Unit"),xh("Gross Req"),xh("Stock"),xh("Pending"),xh("Net Req"),xh("Lead Days"),xh("Status")]);
  Object.keys(gross).forEach(function(rid){
    var g=gross[rid];
    var raw=rawMats.find(function(r){return r.id===rid;});
    var stock=raw?raw.stock:0;
    var pend=raw&&Array.isArray(raw.pending)?raw.pending.reduce(function(a,p){return a+p.qty;},0):0;
    var net=Math.max(0,g.total-stock-pend);
    r1.push([net>0?xw(g.rawName):xok(g.rawName),xc(g.unit),xn(g.total),xn(stock),xn(pend),xn(net),xn(raw?raw.leadTime||0:0),net>0?xw("SHORTAGE"):xok("OK")]);
  });
  if(Object.keys(gross).length===0)r1.push([xc("No requirements — check BOM setup"),xc(""),xc(""),xc(""),xc(""),xc(""),xc(""),xc("")]);

  // Sheet 2 - Pending Orders
  var r2=[[xh("Pending Orders — Raw Materials"),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r2.push([xh("Material"),xh("Unit"),xh("Qty"),xh("Expected Date"),xh("Overdue"),xh("Note / PO Ref")]);
  rawMats.forEach(function(r){
    var pa=Array.isArray(r.pending)?r.pending:[];
    if(pa.length===0)return;
    pa.sort(function(a,b){return a.date>b.date?1:-1;}).forEach(function(p,i){
      var ov=p.date<todayStr();
      r2.push([xc(i===0?r.name:""),xc(i===0?r.unit:""),xn(p.qty),xc(p.date),ov?xw("YES"):xok("No"),xc(p.note||"")]);
    });
  });
  if(r2.length===2)r2.push([xc("No pending orders"),xc(""),xc(""),xc(""),xc(""),xc("")]);

  // Sheet 3 - Daily breakdown
  var r3=[[xh("Daily Material Requirements"),xh(""),xh(""),xh(""),xh("")]];
  r3.push([xh("Date"),xh("Product"),xh("Material"),xh("Qty Required"),xh("Unit")]);
  wdates.forEach(function(dd){
    var bs=getBatches(dd);var first=true;
    bs.forEach(function(b){
      var prod=state.products.find(function(p){return p.name===b.product;});
      if(!prod||!prod.bom||prod.bom.length===0)return;
      prod.bom.forEach(function(line){
        r3.push([xc(first?dd:""),xc(b.product),xc(line.rawName),xn(line.qtyPerKL*b.vol),xc(line.unit)]);
        first=false;
      });
    });
  });
  if(r3.length===2)r3.push([xc("No production scheduled"),xc(""),xc(""),xc(""),xc("")]);

  dlBlob(buildXls([
    {name:"MRP Summary",cols:[160,60,90,90,90,100,80,80],rows:r1},
    {name:"Pending Orders",cols:[160,60,90,110,70,180],rows:r2},
    {name:"Daily Requirements",cols:[110,160,160,90,60],rows:r3}
  ]),"MRP_"+from+"_"+to+".xls");
}

function exportPackagingMaterials(state,from,to){
  var dates=[];var d=from;while(d<=to){dates.push(d);d=addDays(d,1);}
  var mats=state.materials||[];

  // Sheet 1 - Stock Status
  var r1=[[xh("Packaging Materials — Report: "+todayStr()),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r1.push([xh("Material"),xh("Unit"),xh("Stock"),xh("Reorder Level"),xh("Total Pending"),xh("Status")]);
  mats.forEach(function(m){
    var pa=Array.isArray(m.pending)?m.pending:[];
    var pt=pa.reduce(function(a,p){return a+p.qty;},0);
    var low=m.stock<=(m.reorder||0)&&(m.reorder||0)>0;
    r1.push([xc(m.name),xc(m.unit),xn(m.stock),xn(m.reorder||0),xn(pt),low?xw("Low Stock"):xok("OK")]);
  });

  // Sheet 2 - Pending Orders with running balance
  var r2=[[xh("Pending Orders — Packaging Materials"),xh(""),xh(""),xh(""),xh(""),xh("")]];
  r2.push([xh("Material"),xh("Unit"),xh("Order Qty"),xh("Expected Date"),xh("Balance After"),xh("Note / PO Ref")]);
  mats.forEach(function(m){
    var pa=Array.isArray(m.pending)?m.pending:[];
    if(pa.length===0)return;
    var bal=m.stock;
    pa.sort(function(a,b){return a.date>b.date?1:-1;}).forEach(function(p,i){
      var ov=p.date<todayStr();
      bal+=p.qty;
      r2.push([xc(i===0?m.name:""),xc(i===0?m.unit:""),xn(p.qty),ov?xw(p.date+" (Overdue)"):xc(p.date),xn(bal),xc(p.note||"")]);
    });
  });
  if(r2.length===2)r2.push([xc("No pending orders"),xc(""),xc(""),xc(""),xc(""),xc("")]);

  // Sheet 3 - Delivery Timeline (date columns)
  var tlCols=[160,90];dates.forEach(function(){tlCols.push(55);});
  var r3=[[xh("Delivery Timeline"),xh("Start Balance")].concat(dates.map(function(dd){return xh(dd.slice(5));}))];
  r3.push([xh("Material"),xh("Stock")].concat(dates.map(function(){return xh("");})));
  mats.forEach(function(m){
    var pa=Array.isArray(m.pending)?m.pending:[];
    var row=[xc(m.name),xn(m.stock)];
    dates.forEach(function(dd){
      var arr=pa.filter(function(p){return p.date===dd;});
      var tot=arr.reduce(function(a,p){return a+p.qty;},0);
      row.push(tot>0?{v:"+"+tot,s:"blue"}:xc(""));
    });
    r3.push(row);
  });

  dlBlob(buildXls([
    {name:"Stock Status",cols:[180,60,90,90,90,80],rows:r1},
    {name:"Pending Orders",cols:[180,60,90,120,100,180],rows:r2},
    {name:"Delivery Timeline",cols:tlCols,rows:r3}
  ]),"Packaging_Materials_"+from+"_"+to+".xls");
}

