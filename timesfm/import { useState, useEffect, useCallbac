        {rows.map(function(row){
          var pct2=row.grossReq>0?Math.min(100,((row.stock+row.pendTotal)/row.grossReq)*100):100;
          var barColor=row.shortage?"bg-red-500":pct2<80?"bg-yellow-500":"bg-green-500";
          return(
            <div key={row.rawId} className={"border-t "+(row.shortage?"bg-red-50":"")}>
              <div className="grid items-center gap-2 px-4 py-3" style={{gridTemplateColumns:"2fr 1fr 1fr 1fr 1fr 1fr"}}>
