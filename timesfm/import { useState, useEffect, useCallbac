export default function App(){
  var [state,setState]=useState(null);
  var [tab,setTab]=useState("calendar");
  var [loaded,setLoaded]=useState(false);
  useEffect(function(){loadData().then(function(s){setState(s||INIT);setLoaded(true);});},[]);
  useEffect(function(){if(loaded&&state)saveData(state);},[state,loaded]);
  var upd=useCallback(function(fn){setState(function(s){var ns=JSON.parse(JSON.stringify(s));fn(ns);return ns;});},[]);
  if(!state)return <div className="flex items-center justify-center h-screen text-gray-400">Loading...</div>;

  function getBatches(d){return state.batches[d]||[];}
  function getDrumJobs(d){return state.drumJobs[d]||[];}
  function getUtil(d){return state.utilities[d]||{boiler:false,cooling:false,diwater:false};}
  function toggleUtil(d,k){upd(function(s){if(!s.utilities[d])s.utilities[d]={boiler:false,cooling:false,diwater:false};s.utilities[d][k]=!s.utilities[d][k];});}
