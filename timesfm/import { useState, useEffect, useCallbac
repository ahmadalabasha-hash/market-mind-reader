  function saveEditRaw(){props.upd(function(s){var r=s.rawMaterials.find(function(x){return x.id===editRawId;});if(r){r.name=editRawForm.name;r.unit=editRawForm.unit;r.stock=parseFloat(editRawForm.stock)||0;r.reorder=parseFloat(editRawForm.reorder)||0;r.leadTime=parseInt(editRawForm.leadTime)||0;r.supplier=editRawForm.supplier;}});setEditRawId(null);}
