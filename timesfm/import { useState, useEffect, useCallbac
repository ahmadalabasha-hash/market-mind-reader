};

function isHoliday(d){return !!HOLIDAYS[d];}
function isSunday(d){return new Date(d).getDay()===0;}
function isWorkDay(d){return !isSunday(d)&&!isHoliday(d);}
function addDays(d,n){var x=new Date(d);x.setDate(x.getDate()+n);return x.toISOString().slice(0,10);}
function todayStr(){return new Date().toISOString().slice(0,10);}
function pad2(n){return String(n).padStart(2,"0");}
function fmtDate(s){return new Date(s).toLocaleDateString("en-MY",{weekday:"short",day:"numeric",month:"short"});}
function fmtMonth(y,m){return new Date(y,m,1).toLocaleDateString("en-MY",{month:"long",year:"numeric"});}
function timeToMin(t){var p=t.split(":");return parseInt(p[0])*60+parseInt(p[1]);}
function minToTime(m){return pad2(Math.floor(m/60))+":"+pad2(m%60);}
function calcEnd(start,dur){return minToTime(timeToMin(start)+parseInt(dur));}
function daysInMonth(y,m){return new Date(y,m+1,0).getDate();}
function firstDayOfMonth(y,m){var d=new Date(y,m,1).getDay();return d===0?7:d;}
function getMondayOf(d){var x=new Date(d);var day=x.getDay();var diff=day===0?-6:1-day;x.setDate(x.getDate()+diff);return x.toISOString().slice(0,10);}
function pendingTotal(arr){if(!arr||!Array.isArray(arr))return 0;return arr.reduce(function(a,p){return a+(p.qty||0);},0);}

