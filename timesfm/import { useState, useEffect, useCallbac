function MrpView(props){
  var today=todayStr();
  var [rangeType,setRangeType]=useState("weekly");
  var [fromDate,setFromDate]=useState(getMondayOf(today));
  var [repMonth,setRepMonth]=useState(new Date().getMonth());
  var [repYear,setRepYear]=useState(new Date().getFullYear());
  var [toDate,setToDate]=useState(addDays(getMondayOf(today),6));
  var [showExport,setShowExport]=useState(false);
  var dates=[];var startD=fromDate;
  if(rangeType==="monthly"){var dim=daysInMonth(repYear,repMonth);for(var i=1;i<=dim;i++)dates.push(repYear+"-"+pad2(repMonth+1)+"-"+pad2(i));startD=dates[0];}
  else if(rangeType==="weekly"){for(var j=0;j<7;j++)dates.push(addDays(fromDate,j));}
  else{var dd=fromDate;while(dd<=toDate){dates.push(dd);dd=addDays(dd,1);}}
  var workDates=dates.filter(isWorkDay);
  var gross={};
  workDates.forEach(function(d){props.getBatches(d).forEach(function(b){var p=props.state.products.find(function(x){return x.name===b.product;});if(!p||!p.bom||p.bom.length===0)return;p.bom.forEach(function(line){var needed=line.qtyPerKL*b.vol;if(!gross[line.rawId])gross[line.rawId]={rawId:line.rawId,rawName:line.rawName,unit:line.unit,total:0,byDate:{},byProduct:{}};gross[line.rawId].total+=needed;if(!gross[line.rawId].byDate[d])gross[line.rawId].byDate[d]=0;gross[line.rawId].byDate[d]+=needed;if(!gross[line.rawId].byProduct[b.product])gross[line.rawId].byProduct[b.product]=0;gross[line.rawId].byProduct[b.product]+=needed;});});});
  var rawMats=props.state.rawMaterials||[];
  var rows=Object.keys(gross).map(function(rid){var g=gross[rid];var raw=rawMats.find(function(r){return r.id===rid;});var stock=raw?raw.stock:0;var pendArr=raw&&Array.isArray(raw.pending)?raw.pending:[];var pendTotal=pendArr.reduce(function(a,p){return a+p.qty;},0);var net=Math.max(0,g.total-stock-pendTotal);return{rawId:rid,rawName:g.rawName,unit:g.unit,grossReq:g.total,stock:stock,pendTotal:pendTotal,pendArr:pendArr,netReq:net,leadTime:raw?raw.leadTime:0,byDate:g.byDate,byProduct:g.byProduct,supplier:raw?raw.supplier:"",shortage:net>0};});
  rows.sort(function(a,b){return b.shortage-a.shortage||b.grossReq-a.grossReq;});
  var mn=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return(
    <div>
      <div className="font-bold text-xl mb-1">Material Requirements Planning</div>
      <div className="flex justify-between items-center mb-3"><div className="text-xs text-gray-400">Net Req = Gross − Stock − Pending</div><button onClick={function(){setShowExport(true);}} className="px-3 py-1.5 bg-green-600 text-white rounded-lg text-sm font-semibold">Export MRP</button></div>
      <div className="bg-white border rounded-2xl p-4 mb-4 shadow-sm">
        <div className="flex gap-2 mb-3">{[["weekly","This Week"],["monthly","Monthly"],["custom","Custom"]].map(function(item){return <button key={item[0]} onClick={function(){setRangeType(item[0]);}} className={"flex-1 py-2 rounded-xl text-xs font-semibold border "+(rangeType===item[0]?"bg-blue-600 text-white border-blue-600":"bg-white text-gray-600 border-gray-300")}>{item[1]}</button>;})}</div>
        {rangeType==="weekly"&&<div><div className="text-xs text-gray-500 mb-1">Week starting</div><input type="date" value={fromDate} onChange={function(e){setFromDate(getMondayOf(e.target.value));setToDate(addDays(getMondayOf(e.target.value),6));}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div>}
        {rangeType==="monthly"&&<div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">Month</div><select value={repMonth} onChange={function(e){setRepMonth(parseInt(e.target.value));}} className="w-full border rounded-xl px-2 py-2 text-sm">{mn.map(function(m,i){return <option key={i} value={i}>{m}</option>;})}</select></div><div><div className="text-xs text-gray-500 mb-1">Year</div><select value={repYear} onChange={function(e){setRepYear(parseInt(e.target.value));}} className="w-full border rounded-xl px-2 py-2 text-sm">{[2025,2026,2027].map(function(y){return <option key={y} value={y}>{y}</option>;})}</select></div></div>}
        {rangeType==="custom"&&<div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">From</div><input type="date" value={fromDate} onChange={function(e){setFromDate(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div><div><div className="text-xs text-gray-500 mb-1">To</div><input type="date" value={toDate} onChange={function(e){setToDate(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div></div>}
      </div>
      <div className="grid grid-cols-3 gap-2 mb-4">
        <div className="bg-white border rounded-2xl p-3 text-center shadow-sm"><div className="font-bold text-xl text-blue-600">{workDates.length}</div><div className="text-xs text-gray-500">Work Days</div></div>
        <div className="bg-white border rounded-2xl p-3 text-center shadow-sm"><div className="font-bold text-xl text-green-600">{rows.length}</div><div className="text-xs text-gray-500">Materials</div></div>
        <div className="bg-white border rounded-2xl p-3 text-center shadow-sm"><div className={"font-bold text-xl "+(rows.filter(function(r){return r.shortage;}).length>0?"text-red-600":"text-green-600")}>{rows.filter(function(r){return r.shortage;}).length}</div><div className="text-xs text-gray-500">Shortages</div></div>
      </div>
