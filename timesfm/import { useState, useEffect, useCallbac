  "2026-02-10":"Thaipusam","2026-03-28":"Good Friday","2026-04-17":"Nuzul Al-Quran",
  "2026-05-01":"Labour Day","2026-05-12":"Wesak Day","2026-05-31":"Agong Birthday",
  "2026-06-01":"Hari Raya Aidiladha","2026-06-06":"Awal Muharram","2026-07-13":"Maulidur Rasul",
