        {prod&&<div className="bg-gray-50 rounded-xl p-3 text-xs text-gray-600">Mix: {prod.mixTime}h · {prod.conditions} · {prod.pkg} · {(prod.bom||[]).length} BOM lines</div>}
        <div className="flex gap-2">{REACTORS.map(function(r){var disabled=!!(prod&&prod.reactor!=="both"&&prod.reactor!==r.id);return <button key={r.id} onClick={function(){setReactor(r.id);}} disabled={disabled} className={"flex-1 py-2 rounded-xl text-sm font-semibold border "+(reactor===r.id?"bg-blue-600 text-white border-blue-600":"bg-white text-gray-600 border-gray-300")+(disabled?" opacity-30":"")}>{r.label} {r.cap}KL</button>;})}</div>
        <div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">Volume KL</div><input type="number" value={vol} onChange={function(e){setVol(e.target.value);}} placeholder={"Max "+(reactor==="R1"?5:10)} className="w-full border rounded-xl px-3 py-2 text-sm"/></div><div><div className="text-xs text-gray-500 mb-1">Start Time</div><input type="time" value={startTime} onChange={function(e){setStartTime(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div></div>
        {err&&<div className="text-red-600 text-sm bg-red-50 rounded-xl p-3">{err}</div>}
        <button onClick={submit} className="w-full bg-blue-600 text-white py-2.5 rounded-xl font-bold hover:bg-blue-700">Add Batch</button>
      </div>
    </Modal>
  );
}

function DrumModal(props){
  var [source,setSource]=useState(props.fromTank?"tank":"batch");var [batchIdx,setBatchIdx]=useState("");var [product,setProduct]=useState(props.fromTank&&props.state.tank.grade?props.state.tank.grade:"");var [vol,setVol]=useState(props.fromTank?String(props.state.tank.volume):"");var [startTime,setStartTime]=useState("08:00");var [durMin,setDurMin]=useState("60");var [drums,setDrums]=useState("");var [contType,setContType]=useState(CONTAINERS[0]);var [notes,setNotes]=useState("");var [err,setErr]=useState("");
  var batches=props.getBatches(props.date).filter(function(b){return b.pkg===PKG_DRUM||b.pkg===PKG_TANK;});
  var existJobs=props.getDrumJobs(props.date);
  function hasOverlap(s,dur){var ns=timeToMin(s),ne=ns+parseInt(dur);return existJobs.some(function(j){var js=timeToMin(j.startTime),je=js+j.durMin;return ns<je&&ne>js;});}
  function pickBatch(idx){setBatchIdx(idx);if(idx==="")return;var b=batches[parseInt(idx)];setProduct(b.product);setVol(String(b.vol));}
  function submit(){var v=parseFloat(vol),d=parseInt(durMin),dr=parseInt(drums);if(!product)return setErr("Enter product name.");if(!v||v<=0)return setErr("Enter valid volume.");if(!d||d<=0)return setErr("Enter valid duration.");if(!dr||dr<=0)return setErr("Enter container count.");if(source==="tank"&&v>props.state.tank.volume)return setErr("Only "+props.state.tank.volume.toFixed(1)+" ton in tank.");if(hasOverlap(startTime,durMin))return setErr("Overlaps with another job!");setErr("");props.onAdd({id:Date.now(),date:props.date,product:product,vol:v,startTime:startTime,durMin:d,drums:dr,containerType:contType,source:source,notes:notes});}
  return(
    <Modal title={"Schedule Drumming — "+fmtDate(props.date)} onClose={props.onClose}>
      <div className="space-y-3">
        {!props.fromTank&&<div className="flex gap-2">{[["batch","From Batch"],["tank","From Tank"]].map(function(item){return <button key={item[0]} onClick={function(){setSource(item[0]);}} className={"flex-1 py-2 rounded-xl text-sm font-semibold border "+(source===item[0]?"bg-purple-600 text-white border-purple-600":"bg-white text-gray-600 border-gray-300")}>{item[1]}</button>;})}</div>}
        {source==="batch"&&!props.fromTank&&batches.length>0&&<select value={batchIdx} onChange={function(e){pickBatch(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"><option value="">Link to batch (optional)</option>{batches.map(function(b,i){return <option key={i} value={i}>{b.product} · {b.vol}KL · {b.startTime}</option>;})}</select>}
        {source==="tank"&&<div className="bg-amber-50 border border-amber-200 rounded-xl p-2 text-xs text-amber-700">Tank: <strong>{props.state.tank.grade||"Empty"}</strong> · {props.state.tank.volume.toFixed(1)} ton available</div>}
        <input value={product} onChange={function(e){setProduct(e.target.value);}} placeholder="Product / Grade name" className="w-full border rounded-xl px-3 py-2 text-sm"/>
        <div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">Volume KL/ton</div><input type="number" value={vol} onChange={function(e){setVol(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div><div><div className="text-xs text-gray-500 mb-1">Containers</div><input type="number" value={drums} onChange={function(e){setDrums(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div></div>
        <div className="flex gap-2 flex-wrap">{CONTAINERS.map(function(cc){return <button key={cc} onClick={function(){setContType(cc);}} className={"px-3 py-1.5 rounded-xl text-xs font-semibold border "+(contType===cc?"bg-purple-600 text-white border-purple-600":"bg-white text-gray-600 border-gray-300")}>{cc}</button>;})}</div>
        <div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">Start Time</div><input type="time" value={startTime} onChange={function(e){setStartTime(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div><div><div className="text-xs text-gray-500 mb-1">Duration min</div><input type="number" value={durMin} onChange={function(e){setDurMin(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div></div>
        {startTime&&durMin&&<div className="bg-gray-50 rounded-xl p-2 text-xs text-gray-600 text-center">{startTime} to {calcEnd(startTime,parseInt(durMin)||0)}</div>}
        <input value={notes} onChange={function(e){setNotes(e.target.value);}} placeholder="Notes: batch no, label version..." className="w-full border rounded-xl px-3 py-2 text-sm"/>
        {err&&<div className="text-red-600 text-sm bg-red-50 rounded-xl p-3">{err}</div>}
        <button onClick={submit} className="w-full bg-purple-600 text-white py-2.5 rounded-xl font-bold hover:bg-purple-700">Schedule Drumming Job</button>
      </div>
    </Modal>
  );
}
