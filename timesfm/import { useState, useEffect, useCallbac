  function saveProd(){if(!form.name||!form.mixTime)return;props.upd(function(s){s.products.push(Object.assign({},form,{id:"p"+Date.now(),mixTime:parseFloat(form.mixTime),bom:[]}));});setForm({name:"",reactor:"both",mixTime:"",conditions:"",pkg:PKG_DRUM,bulkGrade:""});setShowAdd(false);}

  function startEdit(p){setEditProdId(p.id);setEditForm({name:p.name,reactor:p.reactor,mixTime:String(p.mixTime),conditions:p.conditions||"",pkg:p.pkg,bulkGrade:p.bulkGrade||""});}
