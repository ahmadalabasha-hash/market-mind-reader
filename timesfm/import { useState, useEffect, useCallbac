              </div>
              <div className="px-4 pb-2 flex flex-wrap gap-1">{Object.keys(row.byProduct).map(function(pn){return <span key={pn} className="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">{pn}: {row.byProduct[pn].toFixed(1)} {row.unit}</span>;})}</div>
              {row.shortage&&<div className="px-4 pb-3"><div className="bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 text-xs text-amber-700 font-semibold">Order {row.netReq.toFixed(1)} {row.unit} · Order by: {row.leadTime>0?addDays(startD,-row.leadTime):"ASAP"}{row.supplier?" · "+row.supplier:""}</div></div>}
            </div>
