function Modal(props){
  return(
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div className={"bg-white rounded-2xl shadow-2xl w-full max-h-screen overflow-y-auto "+(props.wide?"max-w-3xl":"max-w-lg")}>
        <div className="flex justify-between items-center p-4 border-b bg-white sticky top-0">
          <div className="font-bold text-lg">{props.title}</div>
          <button onClick={props.onClose} className="text-gray-400 hover:text-gray-600 text-2xl w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100">x</button>
        </div>
        <div className="p-4">{props.children}</div>
      </div>
    </div>
  );
}

function ExportModal(props){
  var today=todayStr();
  var [from,setFrom]=useState(getMondayOf(today));
  var [to,setTo]=useState(addDays(getMondayOf(today),6));
  var [msg,setMsg]=useState("");
  function run(){try{props.onExport(from,to);setMsg("Downloaded!");}catch(e){setMsg("Error: "+e.message);}}
  return(
    <Modal title={props.title} onClose={props.onClose}>
      <div className="space-y-3">
        <div className="text-sm text-gray-500">{props.desc}</div>
        <div className="grid grid-cols-2 gap-3">
          <div><div className="text-xs text-gray-500 mb-1">From Date</div><input type="date" value={from} onChange={function(e){setFrom(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div>
          <div><div className="text-xs text-gray-500 mb-1">To Date</div><input type="date" value={to} onChange={function(e){setTo(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div>
        </div>
        {msg&&<div className={"text-sm rounded-xl p-2 text-center "+(msg.startsWith("Error")?"bg-red-50 text-red-600":"bg-green-50 text-green-700")}>{msg}</div>}
        <button onClick={run} className="w-full bg-green-600 text-white py-2.5 rounded-xl font-bold hover:bg-green-700">Export to Excel</button>
      </div>
    </Modal>
  );
}

