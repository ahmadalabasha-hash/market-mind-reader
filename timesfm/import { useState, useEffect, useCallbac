function ReportView(props){
  var [repType,setRepType]=useState("weekly");var [repDate,setRepDate]=useState(todayStr());var [repMonth,setRepMonth]=useState(new Date().getMonth());var [repYear,setRepYear]=useState(new Date().getFullYear());
  var dates=[];
  if(repType==="daily"){dates=[repDate];}
  else if(repType==="weekly"){var mon=getMondayOf(repDate);for(var i=0;i<7;i++)dates.push(addDays(mon,i));}
  else{var dim2=daysInMonth(repYear,repMonth);for(var j=1;j<=dim2;j++)dates.push(repYear+"-"+pad2(repMonth+1)+"-"+pad2(j));}
  var wd=dates.filter(isWorkDay);var allB=[],allD=[];
  wd.forEach(function(d){props.getBatches(d).forEach(function(b){allB.push(Object.assign({},b,{_d:d}));});props.getDrumJobs(d).forEach(function(jj){allD.push(Object.assign({},jj,{_d:d}));});});
  var tV=allB.reduce(function(a,b){return a+b.vol;},0);var tC=allD.reduce(function(a,jj){return a+jj.drums;},0);
  var byProd={};allB.forEach(function(b){if(!byProd[b.product])byProd[b.product]={batches:0,vol:0,pkg:b.pkg};byProd[b.product].batches++;byProd[b.product].vol+=b.vol;});
  var byR={R1:{batches:0,vol:0},R2:{batches:0,vol:0}};allB.forEach(function(b){if(byR[b.reactor]){byR[b.reactor].batches++;byR[b.reactor].vol+=b.vol;}});
  var kpis=[{l:"Work Days",v:wd.length,c:"bg-blue-50 text-blue-700"},{l:"Batches",v:allB.length,c:"bg-green-50 text-green-700"},{l:"Volume KL",v:tV.toFixed(1),c:"bg-purple-50 text-purple-700"},{l:"Containers",v:tC,c:"bg-amber-50 text-amber-700"}];
  var mn=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return(
    <div>
      <div className="font-bold text-lg mb-4">Production Report</div>
      <div className="bg-white border rounded-2xl p-4 mb-4 shadow-sm"><div className="flex gap-2 mb-3">{[["daily","Daily"],["weekly","Weekly"],["monthly","Monthly"]].map(function(item){return <button key={item[0]} onClick={function(){setRepType(item[0]);}} className={"flex-1 py-2 rounded-xl text-sm font-semibold border "+(repType===item[0]?"bg-blue-600 text-white border-blue-600":"bg-white text-gray-600 border-gray-300")}>{item[1]}</button>;})}</div>
        {repType!=="monthly"&&<div><div className="text-xs text-gray-500 mb-1">Select Date</div><input type="date" value={repDate} onChange={function(e){setRepDate(e.target.value);}} className="w-full border rounded-xl px-3 py-2 text-sm"/></div>}
        {repType==="monthly"&&<div className="grid grid-cols-2 gap-2"><div><div className="text-xs text-gray-500 mb-1">Month</div><select value={repMonth} onChange={function(e){setRepMonth(parseInt(e.target.value));}} className="w-full border rounded-xl px-2 py-2 text-sm">{mn.map(function(m,i){return <option key={i} value={i}>{m}</option>;})}</select></div><div><div className="text-xs text-gray-500 mb-1">Year</div><select value={repYear} onChange={function(e){setRepYear(parseInt(e.target.value));}} className="w-full border rounded-xl px-2 py-2 text-sm">{[2025,2026,2027].map(function(y){return <option key={y} value={y}>{y}</option>;})}</select></div></div>}
      </div>
      <div className="grid grid-cols-2 gap-2 mb-4">{kpis.map(function(k){return <div key={k.l} className={"rounded-2xl p-4 text-center "+k.c}><div className="font-bold text-2xl">{k.v}</div><div className="text-xs opacity-70 font-medium">{k.l}</div></div>;})}</div>
      {Object.keys(byProd).length>0&&<div className="bg-white border rounded-2xl p-4 mb-4 shadow-sm"><div className="font-bold text-sm text-gray-700 mb-3">By Product</div><div className="space-y-2">{Object.keys(byProd).sort(function(a,b){return byProd[b].vol-byProd[a].vol;}).map(function(prod){var p=byProd[prod];var bp=tV>0?(p.vol/tV)*100:0;var bc=p.pkg===PKG_DRUM?"bg-blue-500":p.pkg===PKG_TANK?"bg-amber-500":"bg-green-500";return <div key={prod}><div className="flex justify-between text-xs mb-1"><span className="font-medium">{prod}</span><span className="text-gray-500">{p.batches} batch · {p.vol.toFixed(1)} KL</span></div><div className="h-2 bg-gray-100 rounded-full overflow-hidden"><div className={"h-full rounded-full "+bc} style={{width:bp+"%"}}/></div></div>;})}</div></div>}
      <div className="bg-white border rounded-2xl p-4 mb-4 shadow-sm"><div className="font-bold text-sm text-gray-700 mb-3">Reactor Utilisation</div><div className="grid grid-cols-2 gap-3">{REACTORS.map(function(r){var d=byR[r.id];return <div key={r.id} className="bg-gray-50 rounded-xl p-3"><div className="font-bold text-sm">{r.label}</div><div className="text-xs text-gray-500">{d.batches} batches · {d.vol.toFixed(1)} KL</div></div>;})}</div></div>
      {allB.length===0&&<div className="bg-white border rounded-2xl p-10 text-center text-gray-400">No data for this period.</div>}
    </div>
  );
}

function BatchModal(props){
  var [prodId,setProdId]=useState("");var [reactor,setReactor]=useState("R1");var [vol,setVol]=useState("");var [startTime,setStartTime]=useState("08:00");var [err,setErr]=useState("");
